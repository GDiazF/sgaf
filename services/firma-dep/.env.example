PORT=4010
NODE_ENV=development
SWAGGER_ENABLED=true
API_SECURITY_ENABLED=true
# Par clientId:apiKey que usará Django (x-client-id / x-api-key)
API_CLIENT_KEYS=sgaf-backend:dev-key
API_ALLOW_LOCALHOST=true
# En Docker producción el .env raíz usa API_ALLOW_PRIVATE_NETWORKS=true
API_ALLOW_PRIVATE_NETWORKS=false
API_ALLOWED_IPS=
HTTP_BODY_LIMIT=25mb
DEMO_ENABLED=false
DEMO_CLIENT_ID=demo
DEMO_API_KEY=demo-key

# Docker producción: usar solo ~/sgaf/.env (raíz). Este archivo es para lab local (npm run start:dev).

FIRMA_GOB_ENABLED=true
FIRMA_UNATTENDED_ENABLED=true
# test = CERT | production = prod
FIRMA_GOB_ENVIRONMENT=test
FIRMA_GOB_API_URL=
# CERT (lab): pegar Token Key / Secret de la app de certificación
# Producción: Token e781… / Secret 079f… (solo en .env local/servidor, nunca en Git)
FIRMA_GOB_API_TOKEN_KEY=
FIRMA_GOB_SECRET=
FIRMA_GOB_DEFAULT_ENTITY=Servicio Local de Educación Pública de Iquique
# Con tilde, igual que en la RA
FIRMA_GOB_PURPOSE_ATTENDED=Propósito General
FIRMA_GOB_PURPOSE_UNATTENDED=Desatendido
FIRMA_GOB_TIMEOUT_MS=30000

CORS_ALLOWED_ORIGINS=
TRUST_PROXY_HOPS=1
RATE_LIMIT_PER_MINUTE=60
PDF_MAX_PAGES=300

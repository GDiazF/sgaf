# ==============================================================================
# SGAF - ARCHIVO DE CONFIGURACIÓN DE EJEMPLO (.env.example)
# ==============================================================================
# Instrucciones:
# 1. Producción (Docker): copia este archivo como '.env' en la RAÍZ del proyecto
#    (docker-compose usa env_file: .env). Ver docs/1. guia_primerdespliegue_docker.md
# 2. Desarrollo local (Windows, sin Docker): las variables Django/FirmaGob van en
#    backend/.env  —  ver docs/3. guia_desarrollo_local.md
# 3. Rellena valores reales solo en el .env local/servidor; NUNCA los subas a Git.
# 4. Tras cambiar FIRMAGOB_* en el servidor: docker compose restart backend
# ==============================================================================

# --- SEGURIDAD Y DJANGO ---
SECRET_KEY=tu_clave_secreta_aqui
DEBUG=False
ALLOWED_HOSTS=10.0.100.119,localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://10.0.100.119,http://localhost:5173

# --- BASE DE DATOS (POSTGRESQL) ---
# Nota: En desarrollo local puedes usar SQLite omitiendo estas variables
DB_NAME=sgaf_db
DB_USER=sgaf_user
DB_PASSWORD=tu_password_seguro_aqui
DB_HOST=db
DB_PORT=5432

# --- CONFIGURACIÓN DE CORREO (SMTP) ---
# Nota: Estos valores también pueden ser configurados desde el panel admin
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=soporte.slepiquique@gmail.com
EMAIL_HOST_PASSWORD=tu_password_de_aplicacion_aqui
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=soporte.slepiquique@gmail.com

# --- DOCKER CONFIG ---
BACKEND_PORT=8000
FRONTEND_PORT=5173
NGINX_PORT=8080

# --- LÍMITES Y OTROS ---
EMAIL_DAILY_LIMIT=200
VITE_API_URL=http://localhost:8000/api

# --- FIRMA-DEP (sidecar NestJS :4010) ---
# Las credenciales FirmaGob (Token Key / Secret) viven SOLO en services/firma-dep/.env
# Local (sin Docker): FIRMA_DEP_URL=http://127.0.0.1:4010/api/v1
# Docker compose:     FIRMA_DEP_URL=http://firma-dep:4010/api/v1
FIRMA_DEP_URL=http://127.0.0.1:4010/api/v1
FIRMA_DEP_CLIENT_ID=sgaf-backend
FIRMA_DEP_API_KEY=dev-key

# Etiquetas UI (el JWT lo firma el sidecar)
FIRMAGOB_ENTITY=Servicio Local de Educación Pública de Iquique
FIRMAGOB_PURPOSE=Propósito General
# Legacy (opcional; ya no se usan para firmar desde Django):
# FIRMAGOB_API_TOKEN=
# FIRMAGOB_SECRET=
# FIRMAGOB_API_URL=


# Plantilla Docker/servidor. Copiar con: ./scripts/setup_env.sh
# Desarrollo local Windows: backend/.env — ver docs/3. guia_desarrollo_local.md
# NUNCA subir el .env real a Git.
#
# En el servidor, ./scripts/sync_env_network.sh rellena IP, hostname, CORS y CSRF automáticamente.

# --- SEGURIDAD Y DJANGO ---
SECRET_KEY=tu_clave_secreta_aqui
DEBUG=False
# Sincronizado por scripts/sync_env_network.sh (IP + hostname del servidor)
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost
CSRF_TRUSTED_ORIGINS=http://localhost
# URL pública del frontend (sin /login). El script deploy la detecta automáticamente.
SGAF_PUBLIC_URL=http://localhost
FRONTEND_URL=http://localhost

# --- BASE DE DATOS (POSTGRESQL) ---
# Nota: En desarrollo local puedes usar SQLite omitiendo estas variables
DB_NAME=sgaf_db
DB_USER=sgaf_user
DB_PASSWORD=tu_password_seguro_aqui
DB_HOST=db
DB_PORT=5432

# --- CONFIGURACIÓN DE CORREO (SMTP) ---
# Nota: Estos valores también pueden ser configurados desde el panel admin
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=soporte.slepiquique@gmail.com
EMAIL_HOST_PASSWORD=tu_password_de_aplicacion_aqui
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=soporte.slepiquique@gmail.com

# --- DOCKER CONFIG ---
BACKEND_PORT=8000
FRONTEND_PORT=80
NGINX_PORT=8080

# --- LÍMITES Y OTROS ---
EMAIL_DAILY_LIMIT=200
VITE_API_URL=http://localhost/api

# --- FIRMA-DEP (sidecar NestJS :4010) ---
# Docker: firma-dep lee ESTE mismo .env (no crear services/firma-dep/.env en el servidor).
# Local sin Docker: además copiar services/firma-dep/.env.example → services/firma-dep/.env
FIRMA_DEP_URL=http://firma-dep:4010/api/v1
FIRMA_DEP_CLIENT_ID=sgaf-backend
FIRMA_DEP_API_KEY=CAMBIAR_API_KEY_SEGURA
# Debe coincidir con FIRMA_DEP_CLIENT_ID:FIRMA_DEP_API_KEY
API_CLIENT_KEYS=sgaf-backend:CAMBIAR_API_KEY_SEGURA

# Credenciales FirmaGob (solo en .env del servidor, nunca en Git)
FIRMA_GOB_ENABLED=true
FIRMA_UNATTENDED_ENABLED=true
FIRMA_GOB_ENVIRONMENT=production
FIRMA_GOB_API_URL=
FIRMA_GOB_API_TOKEN_KEY=PEGAR_TOKEN_KEY_RA
FIRMA_GOB_SECRET=PEGAR_SECRET_RA
FIRMA_GOB_DEFAULT_ENTITY=Servicio Local de Educación Pública de Iquique
FIRMA_GOB_PURPOSE_ATTENDED=Propósito General
FIRMA_GOB_PURPOSE_UNATTENDED=Desatendido
FIRMA_GOB_TIMEOUT_MS=30000

# Etiquetas UI Django (el JWT lo arma el sidecar)
FIRMAGOB_ENTITY=Servicio Local de Educación Pública de Iquique
FIRMAGOB_PURPOSE=Propósito General
